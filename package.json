{
  "name": "fiscal-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:au": "vite --host 127.0.0.1 --mode au",
    "dev:us": "vite --host 127.0.0.1 --mode us",
    "build": "tsc -b && vite build && vite build --mode au --outDir dist/au && vite build --mode us --outDir dist/us",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:data": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "refresh": "python3 -m pipeline.refresh",
    "refresh:au": "python3 -m pipeline.refresh --country au",
    "refresh:us": "python3 -m pipeline.refresh --country us",
    "test:hosted": "HOSTED_SMOKE=1 playwright test"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
